# The Dockerfile COPYs only the runtime files explicitly, so this list just
# keeps the build context small — nothing here could reach the image anyway.
# .git stays out but for HEAD and the refs, which the Dockerfile's throwaway
# build-info stage reads to name the commit it builds (build_info.py).
.git/*
!.git/HEAD
!.git/refs
!.git/packed-refs
.gitignore
.env
.env.example
.dockerignore
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
node_modules/
package.json
package-lock.json
tests/
tools/
.github/
.claude/
README.md
ARCHITECTURE.md
CLAUDE.md
docker-compose.yml
