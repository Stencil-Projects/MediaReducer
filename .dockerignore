# The Dockerfile COPYs only the runtime files explicitly, so this list just
# keeps the build context small — nothing here could reach the image anyway.
.git
.gitignore
.env
.env.example
.dockerignore
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
node_modules/
package.json
package-lock.json
tests/
tools/
.github/
.claude/
README.md
ARCHITECTURE.md
CLAUDE.md
docker-compose.yml
